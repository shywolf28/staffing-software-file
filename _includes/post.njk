---
layout: base.njk
---
<article>
  <header class="post-header">
    <div class="post-meta">
      <span class="post-category">{{ category or "Buying guide" }}</span>
      <span class="post-meta-sep"></span>
      <time datetime="{{ date | date('yyyy-MM-dd') }}">{{ date | date('MMMM d, yyyy') }}</time>
      <span class="post-meta-sep"></span>
      <span>{{ content | readTime }} min read</span>
    </div>
    <h1>{{ title }}</h1>
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
